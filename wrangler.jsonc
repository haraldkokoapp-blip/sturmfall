// Cloudflare-Konfiguration: Spiel + Mehrspieler-Server, alles im Gratis-Tarif.
// Lokal testen: npm run dev   |   Online stellen: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sturmfall",
  "main": "server/worker.js",
  "compatibility_date": "2025-11-01",
  "build": { "command": "node server/build.mjs" },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
